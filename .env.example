# Cisco API Console (https://apiconsole.cisco.com) credentials for the PSIRT openVuln API.
# Copy this file to .env and fill in the values. Never commit .env.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=

# NetBox inventory (`check --netbox`): API URL and token of your NetBox instance.
# For the local lab in netbox/docker-compose.yml, NETBOX_TOKEN is nbt_<NETBOX_API_KEY>.<NETBOX_API_SECRET>.
NETBOX_URL=http://127.0.0.1:8000
NETBOX_TOKEN=

# Local NetBox lab only (netbox/docker-compose.yml). Generate random values with
#   uv run python -m netsec_check.netbox.secrets >> .env
NETBOX_DB_PASSWORD=
NETBOX_REDIS_PASSWORD=
NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER=
NETBOX_SUPERUSER_PASSWORD=
NETBOX_API_KEY=
NETBOX_API_SECRET=
