  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Advisory key, e.g. 'webui'",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "advisory_id": {
      "pattern": "^cisco-sa-[A-Za-z0-9-]+$",
      "title": "Advisory Id",
      "type": "string"
    },
    "cves": {
      "items": {
        "pattern": "^CVE-\\d{4}-\\d{4,}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Cves",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuleStatus"
    },
    "os": {
      "const": "ios-xe",
      "default": "ios-xe",
      "title": "Os",
      "type": "string"
    },
    "summary": {
      "description": "Human-readable exposure condition",
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "exposure": {
      "oneOf": [
        {
          "$ref": "#/$defs/AllOf"
        },
        {
          "$ref": "#/$defs/AnyOf"
        },
        {
          "$ref": "#/$defs/Not"
        },
        {
          "$ref": "#/$defs/Line"
        },
        {
          "$ref": "#/$defs/Block"
        },
        {
          "$ref": "#/$defs/Each"
        },
        {
          "$ref": "#/$defs/Platform"
        },
        {
          "$ref": "#/$defs/VlanCoverageCond"
        }
      ],
      "title": "Exposure"
    },
    "affected_platforms": {
      "anyOf": [
        {
          "items": {
            "description": "Python regex (re.search)",
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "PID patterns; None means every platform running the OS",
      "title": "Affected Platforms"
    },
    "mitigations": {
      "items": {
        "$ref": "#/$defs/Mitigation"
      },
      "title": "Mitigations",
      "type": "array"
    },
    "runtime_checks": {
      "items": {
        "$ref": "#/$defs/RuntimeCheck"
      },
      "title": "Runtime Checks",
      "type": "array"
    },
    "remediation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Remediation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "advisory_id",
    "cves",
    "title",
    "status",
    "summary",
    "exposure"
  ],
  "title": "Rule",
  "type": "object"
}
