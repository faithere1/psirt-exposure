      "additionalProperties": false,
      "description": "A config change that removes the exposure (see \"Remediation hints\" above).",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "snippet": {
          "description": "Config commands that remove the exposure",
          "minLength": 1,
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "description",
        "snippet"
      ],
